{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug",
      "type": "debugpy",
      "request": "launch",
      "module": "ohunerin",
      "args": [
        "--host",
        "0.0.0.0",
        "--port",
        "5023"
      ],
      "envFile": "${workspaceFolder}/.env.example",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "env": {
        "OREMI_OHUNERIN_LOG_LEVEL": "DEBUG",
        "OREMI_OHUNERIN_CONFIG_PATH": "config.json",
        "OREMI_OHUNERIN_MODEL_PATH": "models/yamnet.tflite",
        "OREMI_OHUNERIN_SOUNDS_CONFIG_PATH": "sounds.json",
        "OREMI_OHUNERIN_WAKEWORDS_CONFIG_PATH": "wakewords.json"
      }
    }
  ]
}