{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Server",
      "type": "debugpy",
      "request": "launch",
      "module": "ohunerin",
      "args": [
        "--host", "0.0.0.0",
        "--port", "5023",
        "--model", "models/yamnet.tflite"
