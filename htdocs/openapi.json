{
  "openapi": "3.0.0",
  "info": {
    "title": "Oremi Ohunerin",
    "version": "4.0.0b1"
  },
  "paths": {
    "/ws": {
      "get": {
        "summary": "Real-time Ambient Sound and Wake Word Detection",
        "description": "Establish a WebSocket connection to stream raw PCM audio for real-time ambient sound and wake word detection.\n\n**Connection Protocol**\n1. **Establish Connection**: Open a WebSocket connection to `/ws` with query parameters configuring the session.\n2. **Audio Streaming**: Stream raw single-channel, 16-bit PCM audio (at 16000Hz) to the server as binary frames.\n3. **Event Notification**: Receive real-time [DetectedSound](#models/DetectedSound) JSON events from the server when a sound or wake word is recognized.\n\n**Connection Closure Codes**\n- `1000`: Normal closure.\n- `1003`: Invalid request query parameters or error during audio processing.\n- `1008`: Endpoint path is not `/ws`.\n- `1007`: Connection established but no valid feature was specified in query parameters.",
        "responses": {
          "101": {
            "description": "Switching protocols to WebSockets. The connection communicates using the [DetectedSound](#models/DetectedSound) schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetectedSound"
                }
              }
            }
          }
        },
        "tags": [
          "Oremi Ohunerin Endpoints"
        ],
        "parameters": [
          {
            "name": "features",
            "in": "query",
            "required": true,
            "description": "Comma-separated list of features to enable. Supported values: `wakeword-detection`, `sound-detection`.",
            "schema": {
              "type": "string",
              "example": "wakeword-detection,sound-detection"
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "description": "Target language code. Required if `features` contains `wakeword-detection`.",
            "schema": {
              "type": "string",
              "enum": [
                "fr",
                "en"
              ],
              "example": "fr"
            }
          }
        ]
      }
    },
    "/health": {
      "get": {
        "summary": "Get Server Information",
        "description": "Returns details about the server, including name, version, configured detection threshold, and supported wake words by language.",
        "responses": {
          "200": {
            "description": "Server information retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerInfo"
                }
              }
            }
          }
        },
        "tags": [
          "Oremi Ohunerin Endpoints"
        ]
      }
    },
    "/api/sounds": {
      "get": {
        "summary": "Get Supported Sounds",
        "description": "Returns the list of supported ambient sound classes that can be detected by the sound-detection engine.",
        "responses": {
          "200": {
            "description": "Supported sounds retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Oremi Ohunerin Endpoints"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "DictionaryEntry": {
        "type": "object",
        "description": "A dictionary entry mapping a word to its pronunciation phone sequence.",
        "properties": {
          "word": {
            "type": "string",
            "description": "The wake word or discriminant string.",
            "example": "oremi"
          },
          "phones": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The phonetic pronunciation representation for the word.",
            "example": [
              "oo rr ei mm ii"
            ]
          }
        },
        "required": [
          "word",
          "phones"
        ]
      },
      "DetectedSound": {
        "type": "object",
        "description": "The model representing a detected sound event (either a wake word or ambient sound).",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "sound",
              "wakeword"
            ],
            "description": "The type of the detected event."
          },
          "sound": {
            "type": "string",
            "description": "The name of the detected sound or wake word.",
            "example": "cough"
          },
          "score": {
            "type": "number",
            "format": "float",
            "description": "The confidence score of the detection.",
            "example": 0.6677674
          },
          "datetime": {
            "type": "string",
            "format": "date-time",
            "description": "The ISO 8601 timestamp of when the sound was detected.",
            "example": "2026-06-13T07:35:04.123456"
          }
        },
        "required": [
          "type",
          "sound",
          "score",
          "datetime"
        ]
      },
      "WakewordDiscriminant": {
        "type": "object",
        "required": [
          "word",
          "phones"
        ],
        "description": "False-positive guard definition used to disambiguate similar-sounding wake words.",
        "properties": {
          "word": {
            "type": "string",
            "description": "The discriminant word used to reduce false positives."
          },
          "phones": {
            "type": "array",
            "description": "Phonetic transcription(s) of the discriminant word.",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "WakewordEntry": {
        "type": "object",
        "required": [
          "language",
          "word",
          "phones"
        ],
        "description": "Wake word definition for a specific language, including phonetic representations and optional discriminants.",
        "properties": {
          "language": {
            "type": "string",
            "description": "BCP-47 language code (e.g., 'en', 'fr')."
          },
          "word": {
            "type": "string",
            "description": "Wake word or phrase to detect."
          },
          "phones": {
            "type": "array",
            "description": "One or more phonetic transcriptions of the wake word.",
            "items": {
              "type": "string"
            }
          },
          "discriminants": {
            "type": "array",
            "description": "Optional list of false-positive guard words that help distinguish similar-sounding wake words.",
            "items": {
              "$ref": "#/components/schemas/WakewordDiscriminant"
            },
            "default": []
          }
        }
      },
      "WakewordsConfig": {
        "type": "object",
        "required": [],
        "description": "Configuration model for wakeword definitions.",
        "properties": {
          "wakewords": {
            "type": "array",
            "description": "All wakeword definitions, grouped by language inside each entry.",
            "items": {
              "$ref": "#/components/schemas/WakewordEntry"
            },
            "default": []
          }
        }
      },
      "SoundsConfig": {
        "type": "object",
        "required": [],
        "description": "Configuration for sound label filtering via allowlist or denylist.",
        "properties": {
          "allowlist": {
            "type": "array",
            "description": "Allowlist (allowlist) of sound labels that the sound-detection feature is permitted to emit.",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "denylist": {
            "type": "array",
            "description": "Denylist (denylist) of sound labels to suppress.",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      },
