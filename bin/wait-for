# Usage: wait-for <host> <port> [timeout]

HOST=$1
PORT=$2
TIMEOUT=${3:-10}  # Default timeout of 10 seconds if not provided

if [ -z "$HOST" ] || [ -z "$PORT" ]; then
  echo "Usage: $0 <host> <port> [timeout]"
  exit 1
fi

start_time=$(date +%s)
end_time=$((start_time + TIMEOUT))

while true; do
  # Try to connect to the port
  nc -z "$HOST" "$PORT" >/dev/null 2>&1
  result=$?

  if [ $result -eq 0 ]; then
    exit 0
  fi

  current_time=$(date +%s)
  if [ $current_time -ge $end_time ]; then
    echo "Timeout waiting for port $PORT on $HOST"
    exit 1
  fi

  sleep 1
done
