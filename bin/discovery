set -e

# Usage: discovery [service_data]

SERVICE_DATA=${1:-'{}'}

# Check if SERVICE_URI and DISCOVERY_URL are defined
if [ -n "$SERVICE_URI" ] && [ -n "$DISCOVERY_URL" ]; then
    # Extract MQTT_HOST and remaining part containing MQTT_PORT and DISCOVERY_CHANNEL
    MQTT_HOST=$(echo "$DISCOVERY_URL" | cut -d':' -f1)
    REMAINING=$(echo "$DISCOVERY_URL" | cut -d':' -f2-)

    # Extract MQTT_PORT and DISCOVERY_CHANNEL from the remaining part
    MQTT_PORT=$(echo "$REMAINING" | cut -d'/' -f1)
    DISCOVERY_CHANNEL=$(echo "$REMAINING" | cut -d'/' -f2)

  if [ -z "$MACHINE_ID" ]; then
    export MACHINE_ID=$(cat /proc/sys/kernel/random/uuid)
  fi

  oremi-discovery \
    --mqtt-host $MQTT_HOST \
    --mqtt-port $MQTT_PORT \
    --client-id "$CLIENT_ID/$MACHINE_ID" \
    --discovery-channel "$DISCOVERY_CHANNEL" \
    --service-name "$SERVICE_NAME" \
    --service-version $SERVICE_VERSION \
    --service-uri $SERVICE_URI \
    --service-data "$SERVICE_DATA"
fi
