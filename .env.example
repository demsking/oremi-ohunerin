# ==============================================================================
# Oremi Ohunerin - Environment Configuration Example
# ==============================================================================
# All environment variables are prefixed with OREMI_OHUNERIN_
# Copy this file to .env and adjust the values according to your environment.

# ------------------------------------------------------------------------------
# Server & Network Configuration
# ------------------------------------------------------------------------------
# Host address to bind the WebSocket and HTTP server to
OREMI_OHUNERIN_SERVER_HOST=0.0.0.0

# Port number for the server to listen on
OREMI_OHUNERIN_SERVER_PORT=5023

# Path to custom wakewords JSON configuration file (default: ~/.local/share/oremi-ohunerin/wakewords.json)
# OREMI_OHUNERIN_WAKEWORDS_CONFIG_PATH=/path/to/custom/wakewords.json

# Path to custom sounds JSON configuration file (default: ~/.local/share/oremi-ohunerin/sounds.json)
# OREMI_OHUNERIN_SOUNDS_CONFIG_PATH=/path/to/custom/sounds.json

# ------------------------------------------------------------------------------
# Security & TLS/SSL Configuration (Optional)
# ------------------------------------------------------------------------------
# Path to SSL certificate file (PEM format)
# OREMI_OHUNERIN_CERT_FILE=/path/to/cert.pem

# Path to SSL private key file (PEM format)
# OREMI_OHUNERIN_KEY_FILE=/path/to/key.pem

# Password to unlock the SSL private key (if encrypted)
# OREMI_OHUNERIN_PASSWORD=secret

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
# Logging severity level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
OREMI_OHUNERIN_LOG_LEVEL=INFO

# Path to log output file (default: stderr)
# OREMI_OHUNERIN_LOG_FILE=/var/log/oremi-ohunerin.log

# ------------------------------------------------------------------------------
# Detection & Model Configuration
# ------------------------------------------------------------------------------
# Path to custom TFLite audio classification model (default: ~/.local/share/oremi-ohunerin/yamnet.tflite)
# OREMI_OHUNERIN_MODEL_PATH=/path/to/yamnet.tflite

# Score threshold for sound detection filtering (between 0.0 and 1.0)
OREMI_OHUNERIN_THRESHOLD=0.1
