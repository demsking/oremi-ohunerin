  "components": {
    "schemas": {
      "DictionaryEntry": {
        "type": "object",
        "description": "A dictionary entry mapping a word to its pronunciation phone sequence.",
        "properties": {
          "word": {
            "type": "string",
            "description": "The wake word or discriminant string.",
            "example": "oremi"
          },
          "phones": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The phonetic pronunciation representation for the word.",
            "example": [
              "oo rr ei mm ii"
            ]
          }
        },
        "required": [
          "word",
          "phones"
        ]
      },
      "DetectedSound": {
        "type": "object",
        "description": "The model representing a detected sound event (either a wake word or ambient sound).",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "sound",
              "wakeword"
            ],
            "description": "The type of the detected event."
          },
          "sound": {
            "type": "string",
            "description": "The name of the detected sound or wake word.",
            "example": "oremi"
          },
          "score": {
            "type": "number",
            "format": "float",
            "description": "The confidence score of the detection.",
            "example": 0.85
          },
          "datetime": {
            "type": "string",
            "format": "date-time",
            "description": "The ISO 8601 timestamp of when the sound was detected.",
            "example": "2026-06-13T07:35:04.123456"
          }
        },
        "required": [
          "type",
          "sound",
          "score",
          "datetime"
        ]
      },
      "WakewordDetectionFeature": {
        "type": "object",
        "description": "Configuration model representing the wake word detection feature.",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "wakeword-detection"
            ],
            "description": "The name of the feature."
          },
          "language": {
            "type": "string",
            "enum": [
              "fr",
              "en"
            ],
            "description": "The target language code."
          },
          "wakewords": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DictionaryEntry"
            },
            "description": "List of custom wake words dictionary entries."
          },
          "discriminants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DictionaryEntry"
            },
            "description": "List of custom discriminants dictionary entries."
          }
        },
        "required": [
          "name",
          "language"
        ]
      },
      "SoundDetectionFeature": {
        "type": "object",
        "description": "Configuration model representing the sound detection feature.",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "sound-detection"
            ],
            "description": "The name of the feature."
          },
          "allowlist": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of sound names to allow for detection."
          }
        },
        "required": [
          "name"
        ]
      },
      "WakewordSetting": {
        "type": "object",
        "description": "Settings for the wake word detection engine loaded from the configuration file.",
        "properties": {
          "model": {
            "type": "string",
            "description": "Directory containing the acoustic model files."
          },
          "dictionary": {
            "type": "string",
            "description": "Dictionary filename."
          },
          "discriminants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DictionaryEntry"
            },
            "description": "List of Discriminant objects representing the discriminants."
          },
          "wakewords": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DictionaryEntry"
            },
            "description": "List of Wakeword objects representing the wakewords."
          }
        },
        "required": [
          "model",
          "dictionary",
          "discriminants",
          "wakewords"
        ]
      },
      "ServerInfo": {
        "type": "object",
        "description": "Information about the running server.",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the application.",
            "example": "oremi-ohunerin"
          },
          "version": {
            "type": "string",
            "description": "The version of the running server.",
            "example": "3.0.0"
          },
          "threshold": {
            "type": "number",
            "format": "float",
            "description": "The configured detection threshold for filtering predictions.",
            "example": 0.1
          },
          "wakewords": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Map of supported language codes to their default wake words.",
            "example": {
              "fr": [
                "oremi",
                "dikomlam"
              ],
              "en": [
                "oremi",
                "dikomlam"
              ]
            }
          }
        },
        "required": [
          "name",
          "version",
          "threshold",
          "wakewords"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "Oremi Ohunerin Endpoints",
      "description": "API endpoints for real-time ambient sound and wake word detection."
    }
  ]
}