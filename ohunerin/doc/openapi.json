  "paths": {
    "/ws": {
      "get": {
        "summary": "Real-time Ambient Sound and Wake Word Detection",
        "description": "Establish a WebSocket connection to stream raw PCM audio for real-time ambient sound and wake word detection.\n\n### Connection Protocol\n1. **Establish Connection**: Open a WebSocket connection to `/ws` with query parameters configuring the session.\n2. **Audio Streaming**: Stream raw single-channel, 16-bit PCM audio (at 16000Hz) to the server as binary frames.\n3. **Event Notification**: Receive real-time [DetectedSound](#models/DetectedSound) JSON events from the server when a sound or wake word is recognized.\n\n### Connection Closure Codes\n- `1000`: Normal closure.\n- `1003`: Invalid request query parameters or malformed JSON payload.\n- `1008`: Endpoint path is not `/ws`.\n- `INVALID_DATA` (e.g. `1007`): Connection established but no feature was specified in query parameters.",
        "responses": {
          "101": {
            "description": "Switching protocols to WebSockets. The connection communicates using the [DetectedSound](#models/DetectedSound) schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetectedSound"
                }
              }
            }
          }
        },
        "tags": [
          "Oremi Ohunerin Endpoints"
        ],
        "parameters": [
          {
            "name": "features",
            "in": "query",
            "required": true,
            "description": "Comma-separated list of features to enable. Supported values: `wakeword-detection`, `sound-detection`.",
            "schema": {
              "type": "string",
              "example": "wakeword-detection,sound-detection"
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "description": "Target language code. Required if `features` contains `wakeword-detection`.",
            "schema": {
              "type": "string",
              "enum": [
                "fr",
                "en"
              ],
              "example": "fr"
            }
          },
          {
            "name": "wakewords",
            "in": "query",
            "required": false,
            "description": "JSON-serialized array of custom wake words dictionary entries. Each entry must conform to the [DictionaryEntry](#models/DictionaryEntry) schema.",
            "schema": {
              "type": "string",
              "example": "[{\"word\": \"alexa\", \"phones\": [\"aa ll ei kk ss aa\"]}]"
            }
          },
          {
            "name": "discriminants",
            "in": "query",
            "required": false,
            "description": "JSON-serialized array of custom discriminants dictionary entries. Each entry must conform to the [DictionaryEntry](#models/DictionaryEntry) schema.",
