{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.10.5/.schema/devbox.schema.json",
  "packages": [
    "tmux@latest",
    "gitmux@latest",
    "tmuxinator@latest",
    "gnumake@latest",
    "pre-commit@latest",
    "hadolint@latest",
    "shellcheck@latest",
    "ruff@latest",
    "skjold@latest",
    "editorconfig-checker@latest",
    "uv@latest",
    "twine@latest",
    "prek@latest"
  ],
  "env": {
    "UV_MANAGED_PYTHON": "1",
    "PYTHONPATH":        ".:.venv/lib/python3.11/site-packages:$PYTHONPATH"
  },
  "shell": {
    "init_hook": [
      "prek install -f",
      "export PATH=.venv/bin:$PATH"
    ],
    "scripts": {}
  }
}
