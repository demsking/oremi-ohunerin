{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.10.5/.schema/devbox.schema.json",
  "packages": [
    "python@3.11",
    "poetry@latest",
    "tmux@latest",
    "gitmux@latest",
    "tmuxinator@latest",
    "gnumake@latest",
    "pre-commit@latest",
    "hadolint@latest",
    "shellcheck@latest",
    "ruff@latest",
    "skjold@latest",
    "python311Packages.autopep8@latest",
    "python311Packages.bandit@latest",
    "python311Packages.reorder-python-imports@latest",
    "python311Packages.pyroma@latest",
    "python311Packages.pytest@latest",
    "python311Packages.twine@latest",
    "yamllint@latest",
    "nodejs@latest",
    "git-lfs@latest"
  ],
  "env": {
    "DEVBOX_COREPACK_ENABLED": "true",
    "PATH":                    "$VENV_DIR/bin:$DEVBOX_PACKAGES_DIR/bin:$PATH",
    "LD_LIBRARY_PATH":         "$DEVBOX_PACKAGES_DIR/lib:$LD_LIBRARY_PATH"
  },
  "shell": {
    "init_hook": ["pre-commit install -f"],
    "scripts":   {}
  }
}
